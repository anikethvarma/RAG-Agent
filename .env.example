# Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Any free model id (ends in ":free"). List current ones with: python main.py --models
# MODEL=meta-llama/llama-3.3-70b-instruct:free
# MODE=agent          # agent = model calls the search tool; simple = retrieve then answer
# TOP_K=3
# MAX_SEARCHES=3
# TEMPERATURE=0.1

# --- Langfuse tracing (optional; leave the keys empty to turn tracing off) ---
# Keys: Langfuse project -> Settings -> API Keys. Free account: https://langfuse.com/cloud
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # EU; US: https://us.cloud.langfuse.com; or your self-hosted URL
# LANGFUSE_TRACING_ENVIRONMENT=development       # keeps local test traces apart from production
